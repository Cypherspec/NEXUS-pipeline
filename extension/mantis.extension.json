{
    "manifestVersion": 1,
    "apiVersion": "1.0.0",
    "id": "nexus.drug-discovery",
    "name": "NEXUS Drug Discovery",
    "version": "0.1.1",
    "publisher": "Nischay Kommisetty",
    "description": "Reads the molecules behind the points on a map: descriptors and drug-likeness, scaffold families as bags, chemical neighbours as edges, the next batch worth assaying, and property predictions with calibrated conformal intervals.",
    "main": "dist/extension.js",
    "activationEvents": [
        "onStartup",
        "onPanel:nexusPanel",
        "onCommand:nexus.drug-discovery.analyzeSelection"
    ],
    "permissions": [
        "maps:read",
        "selection:read",
        "selection:write",
        "bags:write",
        "edges:write",
        "backend:invoke"
    ],
    "contributes": {
        "commands": [
            {
                "id": "nexus.drug-discovery.analyzeSelection",
                "title": "NEXUS: Analyze the selected molecules"
            }
        ],
        "panels": [
            {
                "id": "nexusPanel",
                "title": "NEXUS",
                "entry": "dist/panel.js",
                "styles": ["dist/panel.css"],
                "description": "Molecular analysis, active learning and calibrated prediction over the points on the map."
            }
        ]
    },
    "backend": {
        "runtime": "python",
        "entry": "backend/main.py",
        "requirements": "numpy==2.5.3\n",
        "network": false,
        "actions": ["analyze", "neighbors", "screen", "predict"]
    }
}
